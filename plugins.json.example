{
  "// 说明": "此文件仅作为“插件注册管理”录入参考；不要添加到主系统本地 plugins.json。设置 organization_name 时展示该组织账号；留空会成为公共插件，仅 root 可在账号管理中只读查看全平台账号及登录记录。",
  "id": "campus",
  "name": "校园管理",
  "nameI18n": {
    "zh-CN": "校园管理",
    "zh-TW": "校園管理",
    "en-US": "Campus Management",
    "ja-JP": "キャンパス管理",
    "th-TH": "การจัดการโรงเรียน"
  },
  "description": "整合学校、班级、学生账号和教学工具入口",
  "url": "http://localhost:3006/",
  "allowed_origin": "http://localhost:3006",
  "allowed_host_origins": [
    "http://localhost:3001"
  ],
  "icon": "School",
  "organization_name": "<organization-name>",
  "enabled": true,
  "order": 1,
  "access_scope": "auth-only",
  "version": "1.0.0"
}
